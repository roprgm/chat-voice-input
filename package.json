{
  "name": "chat-voice-input",
  "version": "0.1.0",
  "description": "Composable React voice input for live transcription.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./ai-sdk": {
      "types": "./dist/transcription.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build demo --config demo/vite.config.ts",
    "check": "biome check . && bun run typecheck",
    "demo": "vite demo --config demo/vite.config.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "keywords": [
    "ai",
    "audio",
    "microphone",
    "react",
    "speech-to-text",
    "transcription",
    "voice-input"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.2",
  "dependencies": {
    "lucide-react": "^1.25.0"
  },
  "peerDependencies": {
    "@ai-sdk/gateway": "^4.0.0",
    "ai": "^7.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/gateway": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.23",
    "@biomejs/biome": "^2.5.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai": "^7.0.31",
    "jsdom": "^27.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
