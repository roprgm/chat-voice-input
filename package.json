{
  "name": "chat-voice-input",
  "version": "0.1.0",
  "description": "Composable React voice input for live transcription.",
  "homepage": "https://chat-voice-input.vercel.app",
  "bugs": {
    "url": "https://github.com/roprgm/chat-voice-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roprgm/chat-voice-input.git"
  },
  "author": {
    "name": "Rodrigo Belfiore",
    "url": "https://github.com/roprgm"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./ai-sdk": {
      "types": "./dist/transcribers/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "build:demo": "pnpm --filter chat-voice-input-demo build",
    "check": "biome check . && pnpm typecheck",
    "demo": "pnpm --filter chat-voice-input-demo dev",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && pnpm --filter chat-voice-input-demo typecheck && tsc --project tests/tsconfig.json --noEmit",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "keywords": [
    "ai",
    "audio",
    "microphone",
    "react",
    "speech-to-text",
    "transcription",
    "voice-input"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.13.1",
  "peerDependencies": {
    "@ai-sdk/gateway": "^4.0.0",
    "ai": "^7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/gateway": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.23",
    "@biomejs/biome": "^2.5.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai": "^7.0.31",
    "jsdom": "^27.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
